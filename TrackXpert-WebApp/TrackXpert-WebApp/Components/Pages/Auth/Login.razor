@rendermode InteractiveServer
@page "/auth/login"

@using TrackXpert_WebApp.Handlers
@using TrackXpert_WebApp.Services;
@inject IAuthenticationService Authentication;
@inject NavigationManager NavigationManager;
@inject AuthenticationStateProvider AuthenticationStateProvider;

<PageTitle>Login</PageTitle>

<!--
This example requires updating your template:

```
<html class="h-full bg-white">
<body class="h-full">
```
-->
<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-sm">
        <img class="mx-auto h-24 w-auto" src="/images/logo.png" alt="Your Company">
        <h2 class="text-2xl/9 mt-10 text-center font-bold tracking-tight text-gray-900 dark:text-white">Sign in to your account</h2>
    </div>

    <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
        <EditForm class="space-y-6" Model="UserModel" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div>
                <label for="email" class="text-sm/6 block font-medium text-gray-900 dark:text-white">Email address</label>
                <div class="mt-2">
                    <input @bind-value="UserModel!.Email" type="email" name="email" id="email" placeholder="Enter email address" autocomplete="email"
                           class="outline-1 -outline-offset-1 block w-full rounded-md px-3 py-1.5 text-base text-gray-900 outline outline-zinc-500 placeholder:text-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-zinc-400 dark:bg-zinc-900 dark:text-white sm:text-sm/6">
                </div>
            </div>

            <div>
                <div class="flex items-center justify-between">
                    <label for="password" class="text-sm/6 block font-medium text-gray-900 dark:text-white">Password</label>
                    <div class="text-sm">
                        <a href="#" class="font-semibold text-cyan-500 hover:text-cyan-300">Forgot password?</a>
                    </div>
                </div>
                <div class="mt-2">
                    <input @bind-value="UserModel!.Password" type="password" name="password" id="password" placeholder="Enter password"
                           autocomplete="current-password"
                           class="outline-1 -outline-offset-1 block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-zinc-500 placeholder:text-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-zinc-400 dark:bg-zinc-900 dark:text-white dark:outline-zinc-500 sm:text-sm/6">
                </div>
            </div>

            <div>
                <button type="submit"
                        class="text-sm/6 flex w-full justify-center rounded-md bg-purple-600 px-3 py-1.5 font-semibold text-white shadow-sm hover:bg-purple-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600">
                    @if (isLoading)
                    {
                        <div class="inline-block size-6 animate-spin rounded-full border-[3px] border-current border-t-transparent text-blue-600 dark:text-blue-500" role="status" aria-label="loading">
                            <span class="sr-only">Loading...</span>
                        </div>
                    } else 
                    {
                        <span>Sign in</span>
                    }
                </button>   
            </div>
        </EditForm>

        <p class="text-sm/6 mt-10 text-center text-gray-500">
            Not a member?
            <NavLink href="/auth/register" class="font-semibold text-cyan-500 hover:text-cyan-300">
                Click here to
                register!
            </NavLink>
        </p>
    </div>
</div>


@code {

    private UserLoginModel? UserModel { get; set; } = new();

    private string? errorMessage = null;

    private bool isLoading { get; set; } = false;

    private async Task HandleSubmit()
    {
        isLoading = true;
        string response = await Authentication.LoginAsync(UserModel!);

        if (response == "success")
        {
            if (AuthenticationStateProvider is CustomAuthenticationStateProvider authStateProvider)
            {
                authStateProvider.NotifyUserAuthentication();
            }
            NavigationManager.NavigateTo("/", true);
        }
        else
        {
            errorMessage = response;
        }

        isLoading = false;
    }


}