@using TrackXpert_WebApp.Services;
@inject IAuthenticationService Authentication;
@inject NavigationManager NavigationManager;


<EditForm Model="UserModel" OnValidSubmit="HandleSubmit">
	<DataAnnotationsValidator/>
	<!-- Email input -->
	<div data-mdb-input-init class="form-outline mb-4">
		<label class="form-label" for="loginName">Email</label>
		<input @bind-value="UserModel!.Email" class="form-control" />
	</div>

	<!-- Password input -->
	<div data-mdb-input-init class="form-outline mb-4">
		<label class="form-label" for="loginPassword">Password</label>
		<input @bind-value="UserModel.Password" type="password" class="form-control" />
	</div>

	<!-- 2 column grid layout -->
	<div class="row mb-4">
		<div class="col-md-6 d-flex justify-content-center">
			<!-- Checkbox -->
			<div class="form-check mb-3 mb-md-0">
				<input class="form-check-input" type="checkbox" value="" id="loginCheck" checked />
				<label class="form-check-label" for="loginCheck"> Remember me </label>
			</div>
		</div>

		<div class="col-md-6 d-flex justify-content-center">
			<!-- Simple link -->
			<a href="#">Forgot password?</a>
		</div>
	</div>

	<!-- Submit button -->
	<button type="submit" class="btn btn-primary w-100 mb-4">Sign in</button>

	<ValidationSummary/>
</EditForm>

@code {

	private UserLoginModel? UserModel { get; set; } = new();

	private async Task HandleSubmit()
	{
		string response = await Authentication.LoginAsync(UserModel!);

		if (response == "success")
		{
			NavigationManager.NavigateTo("/");
		} else 
		{
			// BUHU
		}
	}

	
}