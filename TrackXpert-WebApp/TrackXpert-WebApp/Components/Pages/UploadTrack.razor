@rendermode InteractiveServer

@page "/upload-track"

<PageTitle>Upload Track - TrackXpert</PageTitle>

<h1 class="text-center">UploadTrack</h1>

<div class="container">
    <InputFile OnChange="@LoadFiles" id="fileInput" class="form-control" multiple="" accept=".wav,.mp3" />

    @if(errors.Count > 0)
    {
        <h2>Errors</h2>
        <ul class="text-danger">
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    }

</div>