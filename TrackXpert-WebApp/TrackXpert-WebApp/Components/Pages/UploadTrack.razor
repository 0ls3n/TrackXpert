@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Authentication.JwtBearer

@rendermode InteractiveServer
@page "/upload-track"
@attribute [Authorize]

<PageTitle>Upload Track - TrackXpert</PageTitle>

<h1 class="text-center text-5xl text-white">Upload your track!</h1>



<div class="mx-auto w-1/2 pt-5">
    <div class="flex items-center justify-center ">
        <label for="dropzone-file"
            class="flex flex-col items-center justify-center w-full h-64 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50  dark:bg-zinc-700 hover:bg-gray-100 dark:border-zinc-300 dark:hover:border-gray-500 dark:hover:bg-gray-600">
            <div class="flex flex-col items-center justify-center pt-5 pb-6">
                <svg class="w-8 h-8 mb-4 text-gray-500 dark:text-gray-400" aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2" />
                </svg>
                <p class="mb-2 text-sm text-gray-500 dark:text-gray-400"><span class="font-semibold">Click to
                        upload</span> or drag and drop</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">WAV, MP3, AVAC (MAX. 200 MB)</p>
            </div>
            <InputFile OnChange="HandleFileSelected" accept=".wav, .mp3" id="dropzone-file" type="file"
                class="hidden" />
        </label>
    </div>
    <br />
    @if (selectedFile != null)
    {
        <EditForm Model="trackMetadata" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="d-flex flex-column gap-3">

                <div>
                    <label for="@trackMetadata.Title">Song title: </label>
                    <input @bind-value="trackMetadata.Title" class="form-control" placeholder="Song title" />
                </div>

                <div>
                    <label for="@trackMetadata.Genre">Genre: </label>
                    <select @bind="trackMetadata.Genre" class="form-control">
                        @foreach (var key in Enum.GetValues(typeof(TrackGenre)).Cast<TrackGenre>())
                        {
                            <option value="@key">@key.GetDisplayName()</option>
                        }
                    </select>
                </div>

                <div>
                    <label for="@trackMetadata.ReleaseDate">Release date: </label>
                    <br />
                    <InputDate @bind-Value="trackMetadata.ReleaseDate" />
                </div>

                <div class="d-flex gap-2 align-content-between">
                    <div class="w-100">
                        <label for="@trackMetadata.Key">Key: </label>
                        <select @bind="trackMetadata.Key" class="form-control">
                            @foreach (var key in Enum.GetValues(typeof(TrackKey)).Cast<TrackKey>())
                            {
                                <option value="@key">@key.GetDisplayName()</option>
                            }
                        </select>
                    </div>

                    <div class="w-100">
                        <label for="@trackMetadata.Bpm">BPM: </label>
                        <input @bind-value="trackMetadata.Bpm" class="form-control" placeholder="BPM" />
                    </div>
                </div>

                <div>
                    <label for="@trackMetadata.Tags">Tags: </label>
                    <form @onsubmit="AddTag">
                        <input @oninput="e => CurrentTag = e.Value!.ToString()!" @bind-value="CurrentTag"
                            class="form-control" placeholder="Add a tag" />
                    </form>
                </div>

                @if (trackMetadata.Tags!.Count != 0)
                {
                    <div>
                        <ul class="tag-list">
                            @foreach (var tag in trackMetadata.Tags!)
                            {
                                <li class="tag-item">
                                    @tag <button class="remove-tag" @onclick="() => RemoveTag(tag)">x</button>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div>
                    <label for="@trackMetadata.IsExplicit">Is Explicit?: </label>
                    <input @bind-value="trackMetadata.IsExplicit" type="checkbox" placeholder="Is Explicit?" />
                </div>

                <div>
                    <label for="@trackMetadata.Description">Description: </label>
                    <InputTextArea id="description" class="form-control" @bind-Value="trackMetadata.Description" rows="5" />
                </div>

                <button class="btn btn-primary w-auto mx-auto" type="submit">Upload track!</button>
                <ValidationSummary />
            </div>
        </EditForm>
    }
</div>